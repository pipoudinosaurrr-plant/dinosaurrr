// Réglages du serveur de jeux multijoueurs (Cloudflare Workers)
// Le code est dans serveur/index.js. Cloudflare le met en ligne tout seul
// à chaque modification sur GitHub (Workers Builds).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinosaurrr",
  "main": "serveur/index.js",
  "compatibility_date": "2025-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "SALLES", "class_name": "Salle" },
      { "name": "TABLES", "class_name": "Table" },
      { "name": "PRESENCE", "class_name": "Presence" },
      { "name": "COMPTES", "class_name": "Comptes" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Salle"] },
    { "tag": "v2", "new_sqlite_classes": ["Table"] },
    { "tag": "v3", "new_sqlite_classes": ["Presence"] },
    { "tag": "v4", "new_sqlite_classes": ["Comptes"] }
  ],
  "observability": { "enabled": true }
}
